<Window x:Class="Using_quality_analysis_tools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Using_quality_analysis_tools"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Панель сценариев -->
        <WrapPanel Grid.Row="0" Margin="5">

            <GroupBox Header="Performance Profiler (CPU)" Margin="3">
                <StackPanel>
                    <Button Content="CPU Heavy (UI Thread)" Click="StartLongOperation"
                            Margin="2" Padding="6" Width="200"/>
                    <Button Content="CPU Heavy (Background Thread)" Click="StartBackgroundOperation"
                            Margin="2" Padding="6"/>
                    <Button Content="Async/Await (правильный вариант)" Click="StartAsyncOperation"
                            Margin="2" Padding="6"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Memory Usage" Margin="3">
                <StackPanel>
                    <Button Content="Утечка: подписки на событие" Click="CreateEventLeak"
                            Margin="2" Padding="6" Width="200"/>
                    <Button Content="Утечка: статический кэш (1 МБ x N)" Click="CreateStaticListLeak"
                            Margin="2" Padding="6"/>
                    <Button Content="Вызвать GC и замерить" Click="ForceGarbageCollection"
                            Margin="2" Padding="6"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Live Visual Tree / Bindings" Margin="3">
                <StackPanel>
                    <Button Content="Глубокое дерево (30 уровней)" Click="AddDeepVisualTree"
                            Margin="2" Padding="6" Width="200"/>
                    <Button Content="Масса битых привязок (в Output)" Click="AddMassiveBindings"
                            Margin="2" Padding="6"/>
                    <Button Content="Корректная привязка (INPC)" Click="AddProperBinding"
                            Margin="2" Padding="6"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Другие проблемы" Margin="3">
                <StackPanel>
                    <Button Content="Шторм анимаций (100 анимаций)" Click="StartAnimationStorm"
                            Margin="2" Padding="6" Width="200"/>
                    <Button Content="Потенциальный Deadlock" Click="DeadlockDemo"
                            Margin="2" Padding="6"/>
                    <Button Content="Layout Thrashing" Click="LayoutThrashing"
                            Margin="2" Padding="6"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Действия" Margin="3">
                <StackPanel>
                    <Button Content="Очистить UI" Click="ClearAll"
                            Margin="2" Padding="6" Width="160"/>
                    <Button Content="Сбросить утечки" Click="ResetLeaks"
                            Margin="2" Padding="6"/>
                </StackPanel>
            </GroupBox>
        </WrapPanel>

        <!-- Область динамического контента (Live Visual Tree / Layout / Animations) -->
        <ScrollViewer Grid.Row="1" Margin="10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DynamicContentPanel"/>
        </ScrollViewer>

        <!-- Журнал -->
        <DockPanel Grid.Row="2" Margin="10">
            <TextBlock DockPanel.Dock="Top" Text="Журнал событий:" FontWeight="Bold"/>
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>